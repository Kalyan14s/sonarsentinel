# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# ---- Environments & secrets ----
.env
.venv/
venv/

# ---- Data, models and outputs (DVC / shared storage, never git) ----
# Anchored to the repository root so docs/data/ stays tracked.
# Dataset folders are ignored (versioned with DVC). Files directly in data/raw/ (DVC pointer
# files *.dvc, *.PROVENANCE.yaml, DOWNLOAD_SUMMARY.json) stay visible to git AND to DVC.
# Don't ignore data/ as a whole: DVC skips git-ignored trees and would not find the pointers.
/data/raw/*/
/data/raw/*.commit.txt
/data/interim/
/data/processed/
/data/synthetic/
/data/test/
/data/uploads/
/data/results/
/data/work/
/models/
/runs/
/results/
/labels/
/tiles/
*.mbtiles

# ---- Large sonar / raster files anywhere ----
*.xtf
*.jsf
*.sl2
*.sl3
*.tif
*.tiff

# ---- Node / frontend ----
node_modules/
/frontend/dist/

# ---- DVC internals ----
/.dvc/tmp
/.dvc/cache

# ---- OS / editors ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
~$*
