{
  "name": "sonarsentinel-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SonarSentinel web dashboard (React + TypeScript + Vite + Leaflet)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:types": "json2ts -i ../backend/sonarsentinel/report/schema/report-1.0.schema.json -o src/api/report-schema.ts --bannerComment \"/* Generated from backend/sonarsentinel/report/schema/report-1.0.schema.json by npm run gen:types. Do not edit. */\""
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
